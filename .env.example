APP_NAME="Sistema de venda de bilhetes para transportes rodoviários de Moçambique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Maputo

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de dados -------------------------------------------------
# Opção A (mais rápida, sem instalar nada): SQLite
DB_CONNECTION=sqlite
# (o Laravel usa database/database.sqlite; o script de instalação cria o ficheiro)

# Opção B (como no documento): MySQL — comenta as linhas da opção A e descomenta estas
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=moztransport
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# O Laravel autentica com o modelo Utilizador (tabela "utilizadores")
AUTH_MODEL=App\Models\Utilizador

# Emails (recuperação de palavra-passe). "log" escreve o email em storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@moztransport.co.mz"
MAIL_FROM_NAME="${APP_NAME}"

# Demonstração: atalhos de login e código de recuperação visível no ecrã. Põe false em produção.
MOZ_DEMO=false
